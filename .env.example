# MongoDB Atlas connection string
# Replace with your actual Atlas URI from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# The MongoDB database name (default: nursery)
MONGODB_DB=nursery
